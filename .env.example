# --- App ---
EVE_ENV=local
EVE_LOG_LEVEL=INFO

# --- Validation engine ---
# Whether the real-time /v1/verify endpoint performs live DNS/MX lookups.
# Off by default so the API is deterministic & offline-friendly in dev.
EVE_ENABLE_DNS=true
# SMTP mailbox probing (Layer 6/7) — requires port-25-capable egress IPs (M2).
# Keep false until the SMTP subsystem exists.
EVE_ENABLE_SMTP=false
# DNS resolver timeout (seconds) for MX lookups.
EVE_DNS_TIMEOUT=5.0

# --- Infra (used from M1 onward; harmless defaults for local compose) ---
EVE_DATABASE_URL=postgresql+asyncpg://eve:eve@postgres:5432/eve
EVE_REDIS_URL=redis://redis:6379/0
EVE_S3_ENDPOINT=http://minio:9000
EVE_S3_ACCESS_KEY=minioadmin
EVE_S3_SECRET_KEY=minioadmin
EVE_S3_BUCKET=eve-uploads
