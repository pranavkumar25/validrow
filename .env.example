# Copy to .env and edit. Every infra setting below is EMPTY by default, and
# empty means "use the in-process/on-disk backend". That is deliberate: a
# placeholder like redis://localhost:6379 cannot be told apart from a real
# setting, so the process could never decide whether Redis was configured.

# --- App ---
EVE_ENV=local
EVE_LOG_LEVEL=INFO
# Emit one JSON object per log line. Leave off locally; turn on wherever
# something is collecting the logs.
EVE_LOG_JSON=false

# --- Validation engine ---
# Whether the real-time /v1/verify endpoint performs live DNS/MX lookups.
EVE_ENABLE_DNS=true
# SMTP mailbox probing (Layer 6/7) — requires port-25-capable egress IPs.
EVE_ENABLE_SMTP=false
# DNS resolver timeout (seconds) for MX lookups.
EVE_DNS_TIMEOUT=5.0

# --- SMTP probe identity (set before EVE_ENABLE_SMTP=true) ---
# The shipped defaults end in .local and are not deliverable identities: most
# receivers drop the connection. Use a real subdomain whose egress IPs have
# matching PTR records and an SPF record. The API warns at startup if SMTP is
# enabled while these are still placeholders.
# EVE_SMTP_HELO_HOSTNAME=verify.yourdomain.com
# EVE_SMTP_MAIL_FROM=verify@yourdomain.com
# Comma-separated source IPs to probe from; empty uses the OS default route.
# EVE_SMTP_EGRESS_IPS=

# --- DNSBL monitoring of the egress IPs ---
# Runs only when SMTP is enabled and EVE_SMTP_EGRESS_IPS names IPs to watch. A
# listing cools the IP out of rotation and logs at ERROR. Turn this off only if
# something else is watching the same IPs' reputation.
EVE_DNSBL_ENABLED=true
# Comma-separated zones; empty uses Spamhaus / Barracuda / SpamCop.
EVE_DNSBL_ZONES=
EVE_DNSBL_INTERVAL_SECONDS=3600

# --- Greylisting: deferred re-probes ---
# A 4xx defers us rather than answering us, so the address is retried on this
# schedule and only settles `unknown` once the attempts run out. A cleared
# retry updates the address row; the job's CSVs stay the snapshot they were.
EVE_REPROBE_ENABLED=true
EVE_REPROBE_MAX_ATTEMPTS=3
# Seconds before each retry. Minutes, not seconds: a greylister that cleared
# instantly would not be doing its job.
EVE_REPROBE_DELAYS=900,1800,3600
# How often a process looks for retries that have come due.
EVE_REPROBE_POLL_SECONDS=60

# --- Web app ---
# Whose workspace the sidebar says this is. There is no auth yet, so these are
# declared rather than authenticated. Leave them empty and the UI names the
# workspace and the engine host instead of inventing a signed-in person.
EVE_WORKSPACE_NAME=
EVE_WORKSPACE_EMAIL=
# Which workspace this process reads and writes. Every job and address row
# carries it, so two tenants can share one database without their de-duplicated
# addresses merging. One process serves one workspace until auth lands.
EVE_WORKSPACE_ID=default

# --- Database (jobs + every validated address) ---
# Empty -> a SQLite file inside the storage dir, which is lost on redeploy and
# cannot be shared between instances. Set a Postgres URL for anything real.
# The schema is migrated to head on startup either way.
EVE_WORKSPACE_DB_URL=
# EVE_WORKSPACE_DB_URL=postgresql+asyncpg://eve:eve@postgres:5432/eve

# --- Object storage (uploads + result CSVs) ---
# Bucket + both keys must be set to switch off local disk. Endpoint is blank
# for AWS S3; set it for Cloudflare R2, MinIO or Spaces.
# Requires: pip install -e '.[s3]'
EVE_S3_BUCKET=
EVE_S3_ACCESS_KEY=
EVE_S3_SECRET_KEY=
EVE_S3_ENDPOINT=
EVE_S3_REGION=

# --- Redis (job queue + per-MX rate limiter) ---
# Without it, bulk jobs run in the API process and die on redeploy, and each
# instance gets its own full probe budget against the same provider.
# Requires: pip install -e '.[redis,worker]'
EVE_REDIS_URL=
# auto | inline | arq — auto uses arq when Redis is configured.
EVE_QUEUE_BACKEND=auto

# --- API hardening ---
EVE_MAX_UPLOAD_BYTES=104857600
# Comma-separated allowed origins. Empty = same-origin only.
EVE_CORS_ORIGINS=
# Requests per minute per client IP on /v1/verify, /v1/files and POST /v1/jobs.
# 0 disables it — fine locally, wrong for anything public. The API warns at
# startup when it is off outside EVE_ENV=local.
EVE_RATE_LIMIT_PER_MINUTE=0

# --- Webhooks ---
# Signs the payload as X-Eve-Signature: sha256=HMAC(secret, "<timestamp>.<body>")
EVE_WEBHOOK_SECRET=
EVE_WEBHOOK_TIMEOUT=10.0
EVE_WEBHOOK_MAX_ATTEMPTS=5

# --- Observability ---
# Requires: pip install -e '.[sentry]'
EVE_SENTRY_DSN=
