# Copy to .env on the server. This is the production shape of .env.example —
# every value here is one the app behaves differently for, and the API logs a
# warning at startup for each one left wrong outside `local`.
#
#   cp .env.production.example .env && $EDITOR .env
#   docker compose -f docker-compose.prod.yml up -d --build

# --- Where this is served ---
SITE_DOMAIN=validrow.inboxrow.com
EVE_ENV=production
EVE_LOG_JSON=true

# --- Auth. All three differ from the shipped defaults. ---
# Off by default so a fresh checkout runs; on here, or the app and /v1 are
# open to anyone who can reach the box.
EVE_REQUIRE_AUTH=true
# On for a public launch. Off means only the first account can ever be created.
EVE_OPEN_SIGNUP=true
# Leave true. Caddy terminates TLS, so the cookie never crosses plain HTTP.
EVE_SESSION_COOKIE_SECURE=true
EVE_SESSION_TTL_SECONDS=1209600

# --- Abuse control ---
# Defaults to 0, meaning OFF. With no paid tier gating volume this is the only
# thing between /v1 and someone running their whole list through it. Counted
# per API key when one is used, per client IP otherwise.
EVE_RATE_LIMIT_PER_MINUTE=60
EVE_MAX_UPLOAD_BYTES=104857600
# Empty means same-origin only, which is right while the UI and API share a host.
EVE_CORS_ORIGINS=

# --- Secrets. Generate, do not invent. ---
#   openssl rand -hex 32
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=eve-uploads
# Leave blank to use the bundled MinIO (add `--profile minio`). Point it at
# Cloudflare R2 instead to keep CSVs off the database disk:
#   EVE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
EVE_S3_ENDPOINT=
# Signs completion webhooks. Empty means unsigned — set it if anyone consumes them.
EVE_WEBHOOK_SECRET=

# --- SMTP. Leave disabled until port 25 and rDNS are actually in place. ---
# With this false the engine returns an honest `unknown` for mailboxes it has
# not probed; it never guesses. Turning it on without a matching PTR and SPF
# gets connections dropped, which is worse than leaving it off.
EVE_ENABLE_SMTP=false
EVE_ENABLE_DNS=true
# EVE_SMTP_HELO_HOSTNAME=verify.inboxrow.com
# EVE_SMTP_MAIL_FROM=verify@inboxrow.com
# Comma-separated egress IPs, each with a PTR record pointing at the HELO name.
# EVE_SMTP_EGRESS_IPS=

# --- Observability ---
# EVE_SENTRY_DSN=
